# --- core
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://embryo:embryo@localhost:5432/embryo

# --- auth (Privy embedded wallets)
PRIVY_APP_ID=
# Dev only: accept "Authorization: Dev <did>" tokens. NEVER enable in production.
AUTH_DEV_BYPASS=false

# --- KYC (Sumsub)
SUMSUB_WEBHOOK_SECRET=

# --- card issuing (Rain)
CARD_ISSUER=mock            # mock | rain
RAIN_API_URL=https://api.raincards.xyz
RAIN_API_KEY=
RAIN_WEBHOOK_SECRET=

# --- chain (Base)
CHAIN=baseSepolia           # base | baseSepolia
RPC_URL=https://sepolia.base.org
KEEPER_PRIVATE_KEY=         # keeper + compliance signer; use a KMS/relayer in production
ROUNDUP_ROUTER_ADDRESS=
ALLOWLIST_GATE_ADDRESS=
CHAIN_DRY_RUN=true          # log instead of sending transactions
